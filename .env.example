# Copy this file to .env and fill in real values.
# Never commit the real .env file — it's already in .gitignore.

# Required — powers the AI morning brief. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Required in production — a long random string used to sign session cookies.
# Locally, if this is left blank, the app falls back to an insecure default
# and logs a warning. Always set a real value before deploying anywhere public.
SESSION_SECRET=

# Optional — defaults to 3000 if not set
PORT=3000

# Optional — enables push notifications (bill reminders, weekly digest,
# over-pace spending alerts). Generate a key pair with:
#   npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=
